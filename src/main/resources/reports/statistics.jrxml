<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
 name="statistics" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25">
 <parameter name="TITLE" class="java.lang.String"/>
 <parameter name="YEAR" class="java.lang.Integer"/>
 <parameter name="TOTAL" class="java.lang.Double"/>
 <field name="libelle" class="java.lang.String"/>
 <field name="nombre" class="java.lang.Integer"/>
 <field name="montant" class="java.lang.Double"/>
 <field name="part" class="java.lang.Double"/>
 <title><band height="75">
  <textField><reportElement x="0" y="0" width="535" height="30" forecolor="#183153"/><textElement textAlignment="Center"><font size="20" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{TITLE}]]></textFieldExpression></textField>
  <textField><reportElement x="0" y="36" width="535" height="22"/><textElement textAlignment="Center"><font size="12"/></textElement><textFieldExpression><![CDATA["Année " + $P{YEAR} + " — Total : " + new java.text.DecimalFormat("#,##0.00").format($P{TOTAL}) + " €"]]></textFieldExpression></textField>
 </band></title>
 <columnHeader><band height="28">
  <rectangle><reportElement x="0" y="0" width="535" height="26" backcolor="#183153" mode="Opaque"/></rectangle>
  <staticText><reportElement x="8" y="5" width="275" height="18" forecolor="#FFFFFF"/><textElement><font isBold="true"/></textElement><text><![CDATA[Libellé]]></text></staticText>
  <staticText><reportElement x="285" y="5" width="65" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font isBold="true"/></textElement><text><![CDATA[Nombre]]></text></staticText>
  <staticText><reportElement x="360" y="5" width="95" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font isBold="true"/></textElement><text><![CDATA[Montant]]></text></staticText>
  <staticText><reportElement x="465" y="5" width="60" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font isBold="true"/></textElement><text><![CDATA[Part]]></text></staticText>
 </band></columnHeader>
 <detail><band height="25">
  <line><reportElement x="0" y="24" width="535" height="1" forecolor="#D9E1E8"/></line>
  <textField><reportElement x="8" y="4" width="275" height="18"/><textFieldExpression><![CDATA[$F{libelle}]]></textFieldExpression></textField>
  <textField pattern="#,##0"><reportElement x="285" y="4" width="65" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression></textField>
  <textField pattern="#,##0.00 €"><reportElement x="360" y="4" width="95" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{montant}]]></textFieldExpression></textField>
  <textField pattern="0.00%"><reportElement x="465" y="4" width="60" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{part}]]></textFieldExpression></textField>
 </band></detail>
 <pageFooter><band height="22"><textField><reportElement x="435" y="4" width="100" height="16"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
</jasperReport>

